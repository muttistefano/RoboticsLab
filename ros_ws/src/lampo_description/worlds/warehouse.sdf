<?xml version='1.0' encoding='ASCII'?>
<sdf version='1.10'>
  <world name='world_demo'>
  <gravity>0 0 -9.8</gravity>
    <!-- 2 ms step: controller_manager runs at 500 Hz, so this still gives one
         control tick per physics step while halving the physics cost. -->
    <physics name='2ms' type='dart'>
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin
      name='gz::sim::systems::Physics'
      filename='gz-sim-physics-system'>
      <!-- Engine selection lives HERE, not in <physics type=...>, and the key
           is <engine><filename>. The original file used <render_engine>, which
           is a Sensors-system key: it was silently ignored, so the intended
           Bullet engine never loaded and DART was used all along.
           Left as DART (the gz-sim default). Bullet Featherstone was tried
           because DART cannot create mimic constraints, but the Robotiq
           gripper's closed 4 bar linkage is over constrained under
           Featherstone and the fingers get flung out of their joint limits.
           DART with a passive gripper is the stable combination, and DART also
           has the better trimesh support that the warehouse walls rely on. -->
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
    </plugin>

    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>

    <!-- Server side of the GUI's "Apply Force Torque" dialog. Without this
         system the dialog publishes wrenches into the void -- and shoving
         the robot IS part of the control exercises (doc/control.md). -->
    <plugin name='gz::sim::systems::ApplyLinkWrench' filename='gz-sim-apply-link-wrench-system'/>

    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
    </plugin>

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.300000012 0.699999988 0.899999976 1</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>
    <magnetic_field>6.0000000000000002e-06 2.3e-05 -4.1999999999999998e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 -1.3 0 0.5</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.01 0.01 0.01 1</specular>
      <intensity>2</intensity>
      <visualize>false</visualize>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
    
    <model name='Depot'>
      <static>true</static>
      <link name='main'>
        <collision name='collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <collision name='WALLS_collision'>
          <geometry>
            <mesh>
              <scale>0.6 0.6 0.6</scale>
              <uri>package://lampo_description/worlds/depot/6/meshes/Depot.dae</uri>
              <submesh>
                <name>WALLS</name>
                <center>false</center>
              </submesh>
            </mesh>
          </geometry>
        </collision>
        <collision name='PILLERS_collision'>
          <geometry>
            <mesh>
              <scale>0.6 0.6 0.6</scale>
              <uri>package://lampo_description/worlds/depot/6/meshes/Depot.dae</uri>
              <submesh>
                <name>PILLERS</name>
                <center>false</center>
              </submesh>
            </mesh>
          </geometry>
        </collision>
        <collision name='crates_collision'>
          <geometry>
            <mesh>
              <scale>0.6 0.6 0.6</scale>
              <uri>package://lampo_description/worlds/depot/6/meshes/Crates.dae</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name='WALLS_visual'>
          <geometry>
            <mesh>
              <scale>0.59999999999999998 0.59999999999999998 0.59999999999999998</scale>
              <uri>package://lampo_description/worlds/depot/6/meshes/Depot.dae</uri>
              <submesh>
                <name>WALLS</name>
                <center>false</center>
              </submesh>
            </mesh>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>1 1 1 1</specular>
            <pbr>
              <metal>
                <albedo_map>package://lampo_description/worlds/depot/6/materials/textures/WALLS_Albedo.png</albedo_map>
                <normal_map>package://lampo_description/worlds/depot/6/materials/textures/WALLS_Normal.png</normal_map>
                <metalness_map>package://lampo_description/worlds/depot/6/materials/textures/WALLS_Metalness.png</metalness_map>
                <roughness_map>package://lampo_description/worlds/depot/6/materials/textures/WALLS_Roughness.png</roughness_map>
                <light_map uv_set='1'>package://lampo_description/worlds/depot/6/materials/textures/DepotLightmap.png</light_map>
              </metal>
            </pbr>
            <script>
              <uri>package://lampo_description/worlds/depot/6/materials/scripts/</uri>
              <uri>materials/textures/</uri>
              <name>UrbanTile/WALLS_Diffuse</name>
            </script>
          </material>
        </visual>
        <visual name='PILLERS_visual'>
          <geometry>
            <mesh>
              <scale>0.59999999999999998 0.59999999999999998 0.59999999999999998</scale>
              <uri>package://lampo_description/worlds/depot/6/meshes/Depot.dae</uri>
              <submesh>
                <name>PILLERS</name>
                <center>false</center>
              </submesh>
            </mesh>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>1 1 1 1</specular>
            <pbr>
              <metal>
                <albedo_map>package://lampo_description/worlds/depot/6/materials/textures/PILLERS_Albedo.png</albedo_map>
                <normal_map>package://lampo_description/worlds/depot/6/materials/textures/PILLERS_Normal.png</normal_map>
                <metalness_map>package://lampo_description/worlds/depot/6/materials/textures/PILLERS_Metalness.png</metalness_map>
                <roughness_map>package://lampo_description/worlds/depot/6/materials/textures/PILLERS_Roughness.png</roughness_map>
                <light_map uv_set='1'>package://lampo_description/worlds/depot/6/materials/textures/DepotLightmap.png</light_map>
              </metal>
            </pbr>
            <script>
              <uri>package://lampo_description/worlds/depot/6/materials/scripts/</uri>
              <uri>materials/textures/</uri>
              <name>UrbanTile/PILLERS_Diffuse</name>
            </script>
          </material>
        </visual>
        <visual name='FLOOR_visual'>
          <geometry>
            <mesh>
              <scale>0.59999999999999998 0.59999999999999998 0.59999999999999998</scale>
              <uri>package://lampo_description/worlds/depot/6/meshes/Depot.dae</uri>
              <submesh>
                <name>FLOOR</name>
                <center>false</center>
              </submesh>
            </mesh>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>1 1 1 1</specular>
            <pbr>
              <metal>
                <albedo_map>package://lampo_description/worlds/depot/6/materials/textures/FLOOR_Albedo.png</albedo_map>
                <normal_map>package://lampo_description/worlds/depot/6/materials/textures/FLOOR_Normal.png</normal_map>
                <metalness_map>package://lampo_description/worlds/depot/6/materials/textures/FLOOR_Metalness.png</metalness_map>
                <roughness_map>package://lampo_description/worlds/depot/6/materials/textures/FLOOR_Roughness.png</roughness_map>
                <light_map uv_set='1'>package://lampo_description/worlds/depot/6/materials/textures/DepotLightmap.png</light_map>
              </metal>
            </pbr>
            <script>
              <uri>package://lampo_description/worlds/depot/6/materials/scripts/</uri>
              <uri>materials/textures/</uri>
              <name>UrbanTile/FLOOR_Diffuse</name>
            </script>
          </material>
        </visual>
        <visual name='crates'>
          <geometry>
            <mesh>
              <scale>0.59999999999999998 0.59999999999999998 0.59999999999999998</scale>
              <uri>package://lampo_description/worlds/depot/6/meshes/Crates.dae</uri>
            </mesh>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>1 1 1 1</specular>
            <pbr>
              <metal>
                <albedo_map>package://lampo_description/worlds/depot/6/materials/textures/Crates_Crates_BaseColor.png</albedo_map>
                <normal_map>package://lampo_description/worlds/depot/6/materials/textures/Crates_Crates_Normal.png</normal_map>
                <roughness_map>package://lampo_description/worlds/depot/6/materials/textures/Crates_Crates_Roughness.png</roughness_map>
              </metal>
            </pbr>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>

      <pose>7.1900899999999996 1.09982 0 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>
  </world>
</sdf>